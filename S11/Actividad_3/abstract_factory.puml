@startuml
title Diagrama UML - Patrón Abstract Factory (UI Multiplataforma)

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam class {
    BackgroundColor White
    ArrowColor #2b5797
    BorderColor #2b5797
}

interface UIFactory {
    + crear_ventana_principal(): VentanaPrincipal
    + crear_menu_navegacion(): MenuNavegacion
    + crear_tabla_resultados(): TablaResultados
    + framework: String
}

class UIFactoryTkinter {
    + crear_ventana_principal(): VentanaPrincipal
    + crear_menu_navegacion(): MenuNavegacion
    + crear_tabla_resultados(): TablaResultados
    + framework: String
}

class UIFactoryPyQt5 {
    + crear_ventana_principal(): VentanaPrincipal
    + crear_menu_navegacion(): MenuNavegacion
    + crear_tabla_resultados(): TablaResultados
    + framework: String
}

UIFactory <|.. UIFactoryTkinter
UIFactory <|.. UIFactoryPyQt5

abstract class VentanaPrincipal {
    + {abstract} mostrar(titulo: String, ancho: int, alto: int): String
    + {abstract} cerrar(): String
}

class VentanaPrincipalTkinter {
    + mostrar(titulo: String, ancho: int, alto: int): String
    + cerrar(): String
}

class VentanaPrincipalPyQt {
    + mostrar(titulo: String, ancho: int, alto: int): String
    + cerrar(): String
}

VentanaPrincipal <|-- VentanaPrincipalTkinter
VentanaPrincipal <|-- VentanaPrincipalPyQt

abstract class MenuNavegacion {
    # items: List[Tuple]
    + agregar_item(etiqueta: String, accion: String): void
    + {abstract} renderizar(): String
}

class MenuNavegacionTkinter {
    + renderizar(): String
}

class MenuNavegacionPyQt {
    + renderizar(): String
}

MenuNavegacion <|-- MenuNavegacionTkinter
MenuNavegacion <|-- MenuNavegacionPyQt

abstract class TablaResultados {
    # columnas: List[String]
    # filas: List[List]
    + configurar_columnas(columnas: List[String]): void
    + agregar_fila(valores: List[String]): void
    + {abstract} renderizar(): String
}

class TablaResultadosTkinter {
    + renderizar(): String
}

class TablaResultadosPyQt {
    + renderizar(): String
}

TablaResultados <|-- TablaResultadosTkinter
TablaResultados <|-- TablaResultadosPyQt

UIFactoryTkinter ..> VentanaPrincipalTkinter : <<creates>>
UIFactoryTkinter ..> MenuNavegacionTkinter : <<creates>>
UIFactoryTkinter ..> TablaResultadosTkinter : <<creates>>

UIFactoryPyQt5 ..> VentanaPrincipalPyQt : <<creates>>
UIFactoryPyQt5 ..> MenuNavegacionPyQt : <<creates>>
UIFactoryPyQt5 ..> TablaResultadosPyQt : <<creates>>

class FormularioBusqueda {
    - _factory: UIFactory
    - ventana: VentanaPrincipal
    - menu: MenuNavegacion
    - tabla: TablaResultados
    + FormularioBusqueda(factory: UIFactory)
    + construir(titulo: String, opciones_menu: List, columnas: List, datos: List): Dict
}

FormularioBusqueda o-- UIFactory : usa
FormularioBusqueda ..> VentanaPrincipal : usa
FormularioBusqueda ..> MenuNavegacion : usa
FormularioBusqueda ..> TablaResultados : usa

@enduml
